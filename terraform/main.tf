terraform {
  # >= 1.11: required for write-only attributes (value_wo) and ephemeral resources
  required_version = ">= 1.11.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7" # 3.7+ for ephemeral "random_password"
    }
  }

  backend "s3" {
    bucket       = "gitops-tfstate-murilo-lab"
    key          = "devsecops/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = var.aws_region
}

# ==========================================
# SECRETS MANAGEMENT (SSM & External Secrets)
# ==========================================

# Ephemeral resource: the value exists only during plan/apply and is NEVER recorded in state or plan files.
ephemeral "random_password" "db_password" {
  length           = 16
  special          = true
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

resource "aws_ssm_parameter" "db_connection" {
  name        = var.ssm_db_connection_param_name
  description = "Database connection string for the GitOps API"
  type        = "SecureString"

  # Write-only: sent to AWS but not persisted in state. Re-sent only when value_wo_version changes.
  # Increment it to rotate the password.
  value_wo         = ephemeral.random_password.db_password.result
  value_wo_version = 1
}

# IAM User creation for External Secrets Operator
resource "aws_iam_user" "eso_user" {
  name = "external-secrets-operator-svc"
}

# Access credential generation (Access Key and Secret Key)
resource "aws_iam_access_key" "eso_user_key" {
  user = aws_iam_user.eso_user.name
}

# Least Privilege IAM Policy application
resource "aws_iam_policy" "eso_policy" {
  name        = "ExternalSecretsOperatorPolicy"
  description = "Restricted read access to database parameter and ECR image pull (token generated by ESO)"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = [
          "ssm:GetParameter",
          "ssm:GetParameters"
        ]
        Effect   = "Allow"
        Resource = aws_ssm_parameter.db_connection.arn
      },
      {
        # Used by ClusterGenerator ECRAuthorizationToken (k8s/base) to keep
        # imagePullSecret ecr-cred renewed.
        Sid      = "EcrGetAuthorizationToken"
        Effect   = "Allow"
        Action   = "ecr:GetAuthorizationToken"
        Resource = "*" # AWS requirement: GetAuthorizationToken does not accept resource-level ARN
      },
      {
        # Token inherits user permissions: pull only, strictly in this repo.
        Sid    = "EcrPullOnlyApiRepo"
        Effect = "Allow"
        Action = [
          "ecr:BatchCheckLayerAvailability",
          "ecr:GetDownloadUrlForLayer",
          "ecr:BatchGetImage"
        ]
        Resource = aws_ecr_repository.api_repo.arn
      }
    ]
  })
}

# Attach IAM policy to user
resource "aws_iam_user_policy_attachment" "eso_attach" {
  user       = aws_iam_user.eso_user.name
  policy_arn = aws_iam_policy.eso_policy.arn
}

# ==========================================
# AMAZON ECR (Container Image Repository)
# ==========================================

resource "aws_ecr_repository" "api_repo" {
  name                 = var.ecr_repository_name
  image_tag_mutability = "IMMUTABLE"
  force_delete         = true

  image_scanning_configuration {
    scan_on_push = true
  }
}

# ECR lifecycle policy: retains only the most recent images for cost optimization (FinOps)
resource "aws_ecr_lifecycle_policy" "api_repo" {
  repository = aws_ecr_repository.api_repo.name

  policy = jsonencode({
    rules = [
      {
        rulePriority = 1
        description  = "FinOps: retain only the latest ${var.ecr_image_retention_count} images in repository"
        selection = {
          tagStatus   = "any"
          countType   = "imageCountMoreThan"
          countNumber = var.ecr_image_retention_count
        }
        action = {
          type = "expire"
        }
      }
    ]
  })
}

# ==========================================
# GITHUB ACTIONS OIDC & IAM ROLE (CI/CD)
# ==========================================

# 1. GitHub OIDC Identity Provider
resource "aws_iam_openid_connect_provider" "github_actions" {
  url = "https://token.actions.githubusercontent.com"

  client_id_list = [
    "sts.amazonaws.com"
  ]

  # Official validated GitHub Actions thumbprints
  thumbprint_list = [
    "6938fd4d98bab03faadb97b34396831e3780aea1",
    "1c58a3a8518e8759bf075b76b750d4f2df264fcd"
  ]
}

# 2. IAM Role assumed by GitHub Actions
resource "aws_iam_role" "github_actions_deploy" {
  name = "GitHubActionsDeployRole"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Federated = aws_iam_openid_connect_provider.github_actions.arn
        }
        Action = "sts:AssumeRoleWithWebIdentity"
        Condition = {
          StringEquals = {
            "token.actions.githubusercontent.com:aud" = "sts.amazonaws.com"
            "token.actions.githubusercontent.com:sub" = var.github_oidc_sub
          }
        }
      }
    ]
  })
}

# 3. Permission Policy for Image Push to ECR (Least Privilege)
resource "aws_iam_policy" "ecr_push_policy" {
  name        = "GitHubActionsECRPushPolicy"
  description = "Allows GitHub Actions to authenticate and push images to ECR"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "GetAuthorizationToken"
        Effect   = "Allow"
        Action   = "ecr:GetAuthorizationToken"
        Resource = "*" # AWS requirement: GetAuthorizationToken does not accept specific ARN
      },
      {
        Sid    = "AllowPushPullOnRepo"
        Effect = "Allow"
        Action = [
          "ecr:BatchCheckLayerAvailability",
          "ecr:GetDownloadUrlForLayer",
          "ecr:BatchGetImage",
          "ecr:PutImage",
          "ecr:InitiateLayerUpload",
          "ecr:UploadLayerPart",
          "ecr:CompleteLayerUpload"
        ]
        # Strictly restricted to gitops-api repository
        Resource = aws_ecr_repository.api_repo.arn
      }
    ]
  })
}

# 4. Attach ECR Policy to GitHub Actions Role
resource "aws_iam_role_policy_attachment" "github_actions_ecr_attach" {
  role       = aws_iam_role.github_actions_deploy.name
  policy_arn = aws_iam_policy.ecr_push_policy.arn
}

# ==========================================
# OUTPUTS
# ==========================================

output "eso_access_key_id" {
  value       = aws_iam_access_key.eso_user_key.id
  description = "Access Key ID for aws-secret-store.yaml"
}

output "eso_secret_access_key" {
  value       = aws_iam_access_key.eso_user_key.secret
  description = "Secret Access Key for aws-secret-store.yaml"
  sensitive   = true
}

output "ecr_repository_url" {
  value       = aws_ecr_repository.api_repo.repository_url
  description = "Repository URL for pushing images"
}

output "github_actions_role_arn" {
  value       = aws_iam_role.github_actions_deploy.arn
  description = "Role ARN for use in GitHub Actions deploy.yaml workflow"
}